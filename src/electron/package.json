{
  "name": "meloamp",
  "version": "1.4.0",
  "main": "main.js",
  "files": [
    "main.js",
    "preload.js",
    "helpers.js",
    "strings.js",
    "build/**/*",
    "package.json"
  ],
  "scripts": {
    "start": "electron .",
    "test": "node --test helpers.test.js strings.test.js",
    "lint": "node --check main.js && node --check preload.js && node --check helpers.js && node --check strings.js"
  },
  "keywords": [],
  "author": "Melodee Team <info@melodee.org>",
  "homepage": "https://melodee.org",
  "license": "MIT",
  "description": "MeloAmp: Cross-platform streaming client for the Melodee.",
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.6"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "mpris-service": "^2.1.2"
  },
  "overrides": {
    "xml2js": "^0.6.2"
  },
  "build": {
    "productName": "MeloAmp",
    "executableName": "MeloAmp",
    "appId": "org.melodee.meloamp",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "compression": "normal",
    "generateUpdatesFilesForAllChannels": false,
    "publish": {
      "provider": "github",
      "owner": "melodee-project",
      "repo": "meloamp",
      "releaseType": "release"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Audio",
      "icon": "resources/logo.png",
      "executableName": "MeloAmp",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/logo.png",
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}",
      "nsis": {
        "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}"
      },
      "portable": {
        "artifactName": "${productName}-${version}-windows-${arch}-portable.${ext}"
      }
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "resources/logo.png",
      "artifactName": "${productName}-${version}-macos-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist"
    },
    "directories": {
      "output": "dist",
      "buildResources": "resources",
      "app": "."
    },
    "extraResources": [
      {
        "from": "build",
        "to": "build"
      },
      {
        "from": "resources/logo.png",
        "to": "resources/logo.png"
      }
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
